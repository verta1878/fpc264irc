+#define N_TXTADDR(x)		(N_MAGIC (x) == ZMAGIC ? 0x10000 : 0)
 #define N_TXTSIZE(x)		((x)->a_text)
 #define TARGET_PAGE_SIZE	4096
-#define SEGMENT_SIZE		0x400000
+#define SEGMENT_SIZE		0x10000
