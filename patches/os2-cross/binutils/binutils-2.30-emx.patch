+/* EMX: count the relocs of SEC in INPUT_BFD that refer to import
+   symbols; a final link keeps them in the executable.  */
+
+static bfd_boolean
+aout_link_count_emx_relocs (bfd *input_bfd, asection *sec,
+			    bfd_size_type rel_size, bfd_size_type *count)
+{
+  struct aout_link_hash_entry **sym_hashes;
+  struct reloc_std_external *relocs, *rel, *rel_end;
+  bfd_size_type sym_count;
+
+  sym_hashes = obj_aout_sym_hashes (input_bfd);
+  sym_count = obj_aout_external_sym_count (input_bfd);
+  if (rel_size == 0 || sym_hashes == NULL
+      || obj_reloc_entry_size (input_bfd) != RELOC_STD_SIZE)
+    return TRUE;
+
+  relocs = (struct reloc_std_external *) bfd_malloc (rel_size);
+  if (relocs == NULL)
+    return FALSE;
+  if (bfd_seek (input_bfd, sec->rel_filepos, SEEK_SET) != 0
+      || bfd_bread (relocs, rel_size, input_bfd) != rel_size)
+    {
+      free (relocs);
+      return FALSE;
+    }
+
+  rel_end = relocs + rel_size / RELOC_STD_SIZE;
+  for (rel = relocs; rel < rel_end; rel++)
+    {
+      unsigned int r_index;
+      int r_extern;
+      struct aout_link_hash_entry *h;
+
+      if (bfd_header_big_endian (input_bfd))
+	{
+	  r_index = (((unsigned int) rel->r_index[0] << 16)
+		     | ((unsigned int) rel->r_index[1] << 8)
+		     | rel->r_index[2]);
+	  r_extern = (0 != (rel->r_type[0] & RELOC_STD_BITS_EXTERN_BIG));
+	}
+      else
+	{
+	  r_index = (((unsigned int) rel->r_index[2] << 16)
+		     | ((unsigned int) rel->r_index[1] << 8)
+		     | rel->r_index[0]);
+	  r_extern = (0 != (rel->r_type[0] & RELOC_STD_BITS_EXTERN_LITTLE));
+	}
+      if (! r_extern || r_index >= sym_count)
+	continue;
+      h = sym_hashes[r_index];
+      while (h != NULL
+	     && (h->root.type == bfd_link_hash_indirect
+		 || h->root.type == bfd_link_hash_warning))
+	h = (struct aout_link_hash_entry *) h->root.u.i.link;
+      if (h != NULL && h->emx_import
+	  && (h->root.type == bfd_link_hash_defined
+	      || h->root.type == bfd_link_hash_defweak))
+	*count += RELOC_STD_SIZE;
+    }
+
+  free (relocs);
+  return TRUE;
+}
