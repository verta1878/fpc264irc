@echo off
rem fpc264irc unit folders: name clashes + stale leftovers - byte, 2026-10-07 - ONE batch does it all
rem Location: C:\Users\owner\Desktop\Claude\share\compilers\unitfolders-run.bat   (next to the fpc264irc folder)
rem Zip:      C:\Users\owner\Desktop\Claude\share\compilers\unitfolders\fpc264irc-unitfolders-2026-10-07.zip
rem RUN darwin-run.bat FIRST (this batch builds on it).
rem 1 move 1469 Lazarus files bin\units\i386-win32 -> bin\units\i386-win32\lcl  (BEFORE the unzip: the zip brings FV dialogs/menus of the same names)
rem 2 move 84 Lazarus files bin\units\i386-go32v2 -> bin\units\i386-go32v2\lcl
rem 3 unzip 104 files, overwriting   4 check   5 delete bin\units\i386-darwin\dialogs.rst (FV, now in fv\)   6 remove marker
rem Works from the compilers folder OR from inside the fpc264irc folder (logs always go to the compilers folder)
setlocal
set "HERE=%~dp0"
set "BASE=%HERE%"
if exist "%HERE%bin\units\" set "BASE=%HERE%..\"
pushd "%BASE%"
set "BASE=%CD%\"
popd
set "REPO=%BASE%fpc264irc"
set "ZIP=%BASE%unitfolders\fpc264irc-unitfolders-2026-10-07.zip"
set "LOG=%BASE%unitfolders-run.log"
echo fpc264irc unitfolders %DATE% %TIME% > "%LOG%"
cd /d "%REPO%"
if not exist "bin\units\i386-win32\" (echo fpc264irc folder not found next to this batch & echo ABORT repo not found >> "%LOG%" & pause & exit /b 1)
